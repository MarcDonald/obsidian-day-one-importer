{
	"name": "obsidian-day-one-importer",
	"version": "1.3.3",
	"description": "Import Day One journals",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"lint": "eslint -c .eslintrc . && prettier -c .",
		"test": "TZ=UTC jest",
		"test:watch": "TZ=UTC jest --watch",
		"lint:fix": "eslint -c .eslintrc --fix . && prettier -c --write .",
		"typecheck": "tsc -noEmit -skipLibCheck",
		"build": "npm run typecheck && node esbuild.config.mjs production",
		"version": "node version-bump.mjs && git add manifest.json versions.json",
		"prepare": "husky"
	},
	"keywords": [
		"obsidian",
		"obsidian-plugin"
	],
	"author": "Marc Donald",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/marcdonald/obsidian-day-one-importer.git"
	},
	"devDependencies": {
		"@jest/globals": "29.7.0",
		"@types/jest": "29.5.14",
		"@types/node": "22.20.5",
		"@typescript-eslint/eslint-plugin": "8.72.1",
		"@typescript-eslint/parser": "8.72.1",
		"builtin-modules": "5.5.0",
		"esbuild": "0.28.2",
		"eslint": "8.57.1",
		"globals": "17.14.0",
		"husky": "9.1.7",
		"jest": "29.7.0",
		"lint-staged": "^16.4.0",
		"obsidian": "1.14.4",
		"prettier": "3.9.10",
		"ts-jest": "29.4.15",
		"tslib": "2.9.1",
		"typescript": "4.8.4"
	},
	"dependencies": {
		"zod": "4.6.7"
	}
}
